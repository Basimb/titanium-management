# Load these through the service manager; this file is NOT automatically loaded.
TEAM_CHAT_BRIDGE_ENABLED=0
# Needed only for a fresh, explicitly authorized linked-device pairing.
TEAM_CHAT_PAIR=0
TEAM_CHAT_BOT_NUMBER=
# E.164 numbers, comma-separated. Every sender (including group members) must match.
TEAM_CHAT_ALLOWED_NUMBERS=
# Exact WhatsApp group JIDs, comma-separated. Empty means ALL groups denied.
TEAM_CHAT_ALLOWED_GROUPS=
TEAM_CHAT_BACKEND_URL=https://www.management.titanium-pharmacy.com/api/whatsapp/team-chat
# Independently provision a random 32-byte key as 64 hex characters on BOTH services.
TEAM_CHAT_SHARED_KEY=
# Absolute private directory outside this repository and outside every web root.
TEAM_CHAT_STATE_DIR=
